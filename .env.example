# --- Ma'lumotlar bazasi ---
POSTGRES_DB=buxcrm_saas
POSTGRES_USER=buxcrm
POSTGRES_PASSWORD=buxcrm_dev_password
DATABASE_URL=postgres://buxcrm:buxcrm_dev_password@localhost:5432/buxcrm_saas
TEST_DATABASE_URL=postgres://buxcrm:buxcrm_dev_password@localhost:5432/buxcrm_saas_test

# --- API ---
PORT=8091
NODE_ENV=development
# Frontend manzili (vergul bilan bir nechta)
CORS_ORIGIN=http://localhost:5175
# Kamida 32 belgi; prod'da albatta almashtiring
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Mijozlarning my.mehnat.uz parollarini shifrlash kaliti (kamida 32 belgi). Yo'qolsa parollar tiklanmaydi!
CREDENTIALS_KEY=change-me-credentials-key-at-least-32-characters

# Platforma (SaaS egasi) admini: shu login bazada bo'lmasa ishga tushishda yaratiladi (parol kamida 8 belgi).
# /platform sahifasidan kompaniyalarni yaratadi, to'lov kiritadi, bloklaydi. Kompaniya rahbari kompaniya bilan birga yaratiladi.
PLATFORM_ADMIN_LOGIN=superadmin
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platforma admini
# Platforma admini sessiyasi (soniya), standart 8 soat
PLATFORM_TOKEN_TTL_SEC=28800

# --- Telegram (ixtiyoriy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Chat fayllari (rasm, video, ovozli xabar) saqlanadigan yopiq kanal: bot shu kanalga admin qilinadi.
# Id odatda -100 bilan boshlanadi. Bo'sh bo'lsa chatda faqat matn yuboriladi.
TELEGRAM_STORAGE_CHAT_ID=

# --- Rejalashtirilgan ishlar ---
SCHEDULER_ENABLED=true
BACKUP_ENABLED=false
BACKUP_DIR=./backups
